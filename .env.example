# Copy this file to `.env` and fill in your key:
#     cp .env.example .env
#
# Get a key at https://console.anthropic.com/settings/keys

# ---- Optional, but needed to *generate* answers ----
# Retrieval, metadata scoping, and the out-of-scope gate all run locally with
# no key at all. Try `python scripts/demo_hybrid.py` or POST /api/search to
# exercise the whole retrieval stack for free.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ---- Model (optional) ----
MODEL=claude-opus-5
MAX_TOKENS=2000
# low | medium | high | xhigh | max  — higher means more reasoning, more cost
EFFORT=medium

# ---- Retrieval tuning (optional) ----
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
# Minimum combined relevance score (0..1) for a question to count as in-scope.
# Raise it to make the bot stricter, lower it to make it more permissive.
# 0.40 is tuned against the bundled examples; see docs/scope-tuning.md.
RELEVANCE_FLOOR=0.40

# ---- Hybrid retrieval (optional) ----
# Which embedder backs dense retrieval.
#   hashing                 zero dependencies, zero download, instant (default)
#   sentence-transformers   true semantic vectors; needs
#                           `pip install sentence-transformers` and a ~90 MB
#                           model download on first run
# Switching backends invalidates the cached vectors automatically — they are
# not comparable across embedders — and the corpus is re-embedded at boot.
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSIONS=1024

# Reciprocal Rank Fusion smoothing constant. Lower sharpens the advantage of
# rank 1; higher pushes toward a simple vote. 60 is the value from the paper.
RRF_K=60

# Relative influence of each retriever. Set either to 0 to isolate the other,
# which is how scripts/measure_hybrid.py attributes their contributions.
LEXICAL_WEIGHT=1.0
DENSE_WEIGHT=1.0

# Dense similarity at or above which a question that fails the lexical gate is
# promoted to `borderline` (where the model must verify scope) instead of being
# refused outright. Measured against the bundled corpora; re-run
# scripts/measure_hybrid.py after changing EMBEDDING_BACKEND. Set to 1.0 to
# disable the rescue entirely.
DENSE_RESCUE_FLOOR=0.25

# ---- Behaviour (optional) ----
STRICT_SCOPE=true
MAX_UPLOAD_MB=25
DATA_DIR=./data

# ---- Multi-tenancy (optional) ----
# Off by default: the service exposes one corpus and needs no credentials.
#
# Set to 1 to serve several customers from one deployment, each with a corpus
# the others cannot read. Every request must then carry `X-API-Key`, and the
# tenant is derived from that key alone — never from a request field, because
# a client that can name its own tenant has no isolation at all.
#
# NOTE the risk in this default: a multi-customer deployment that forgets to
# set this gets NO isolation while appearing to work. /api/status reports the
# live mode and startup logs a warning when tenants are configured but this is
# off. See docs/multi-tenancy.md.
MULTI_TENANT=0

# Tenant credentials: tenant_id:display name:api_key, comma- or
# newline-separated. Tenant ids are lowercase [a-z0-9_-], 1-63 chars.
#
# Plaintext in an env var is adequate for a demo or a small deployment only.
# A real one should hash keys at rest and support rotation without a restart;
# TenantRegistry is the seam for that.
# TENANTS=acme:Acme University:acme-key-xxx,globex:Globex Retail:globex-key-yyy

# The tenant used when MULTI_TENANT=0.
DEFAULT_TENANT_ID=default
